generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Link {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId Int
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId Int
}

model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  achievements String[]
  profile      Profile   @relation(fields: [profileId], references: [id])
  profileId    Int
}

model Project {
  id        Int     @id @default(autoincrement())
  name      String
  url       String
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId Int
}
